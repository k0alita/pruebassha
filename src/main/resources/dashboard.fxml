<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.DashboardController" prefWidth="1200" prefHeight="900">

    <left>
        <VBox alignment="TOP_CENTER" spacing="15.0" style="-fx-background-color: #f4f4f4; -fx-border-color: #dddddd; -fx-border-width: 0 1 0 0;" prefWidth="250.0">
            <padding>
                <Insets top="30.0" right="20.0" bottom="30.0" left="20.0" />
            </padding>

            <Label text="Punto Limpio">
                <font>
                    <Font name="System Bold" size="20.0" />
                </font>
                <VBox.margin>
                    <Insets bottom="20.0" />
                </VBox.margin>
            </Label>

            <!-- Botones del menú lateral -->
            <Button mnemonicParsing="false" onAction="#onCategoria1Click" text="Lista Usuarios" prefWidth="200" prefHeight="40"/>
            <Button mnemonicParsing="false" onAction="#onCategoria2Click" text="Categoría 2 (Pendiente)" prefWidth="200" prefHeight="40"/>
            <Button mnemonicParsing="false" onAction="#onCategoria3Click" text="Categoría 3 (Pendiente)" prefWidth="200" prefHeight="40"/>

            <VBox VBox.vgrow="ALWAYS" />

        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea">
            <padding>
                <Insets top="30.0" right="30.0" bottom="30.0" left="30.0" />
            </padding>

            <VBox alignment="CENTER" spacing="10.0">
                <Label fx:id="lblWelcome" text="Bienvenido al Dashboard">
                    <font>
                        <Font name="System Bold" size="26.0" />
                    </font>
                </Label>
                <Label text="Seleccione una categoría en el menú lateral para ver los detalles." textFill="#666666" />
            </VBox>

        </StackPane>
    </center>

</BorderPane>