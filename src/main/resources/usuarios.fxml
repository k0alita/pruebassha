<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.UsuariosController"
            prefWidth="1200" prefHeight="900">

    <!-- MENÚ LATERAL IZQUIERDO -->
    <left>
        <VBox alignment="TOP_CENTER" spacing="15.0"
              style="-fx-background-color: #f4f4f4; -fx-border-color: #dddddd; -fx-border-width: 0 1 0 0;"
              prefWidth="250.0">
            <padding>
                <Insets top="30.0" right="20.0" bottom="30.0" left="20.0" />
            </padding>

            <Label text="Punto Limpio">
                <font>
                    <Font name="System Bold" size="20.0" />
                </font>
                <VBox.margin>
                    <Insets bottom="20.0" />
                </VBox.margin>
            </Label>

            <Button mnemonicParsing="false" onAction="#onCategoria1Click"
                    text="Cargar Usuarios" prefWidth="200" prefHeight="40"/>
            <Button mnemonicParsing="false" onAction="#onCategoria2Click"
                    text="Categoría 2 (Pendiente)" prefWidth="200" prefHeight="40"/>
            <Button mnemonicParsing="false" onAction="#onCategoria3Click"
                    text="Categoría 3 (Pendiente)" prefWidth="200" prefHeight="40"/>

            <VBox VBox.vgrow="ALWAYS" />
        </VBox>
    </left>

    <!-- ZONA CENTRAL: OCUPA TODO EL ESPACIO RESTANTE -->
    <center>
        <VBox spacing="10.0" style="-fx-background-color: white;">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
            </padding>

            <Label text="Tabla de Usuarios">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
            </Label>

            <!-- VBox.vgrow="ALWAYS" hace que la tabla estire verticalmente también -->
            <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS"
                       maxWidth="Infinity" maxHeight="Infinity">
                <columns>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="200.0" />
                    <TableColumn fx:id="colApellido" text="Apellido" prefWidth="600.0" />
                    <TableColumn fx:id="colDni" text="DNI" prefWidth="600.0" />
                </columns>
                <!-- Hace que las columnas se distribuyan en todo el ancho disponible -->
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

</BorderPane>